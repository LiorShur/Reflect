{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        "profile": {
          "display_name": {
            ".write": "auth != null && auth.uid === $uid"
          },
          "created_at": {
            ".write": "auth != null && auth.uid === $uid"
          },
          "partner_uid": {
            ".write": false
          },
          "paired_at": {
            ".write": false
          },
          "active_session_id": {
            ".write": false
          },
          "last_conflict_at": {
            ".write": false
          }
        },
        "settings": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "screening": {
          ".write": false
        },
        "baseline": {
          ".write": false
        }
      }
    },

    "sessions": {
      ".indexOn": ["meta/partnerA", "meta/partnerB"],

      "$sid": {

        "meta": {
          ".read": "auth != null && (data.child('partnerA').val() === auth.uid || data.child('partnerB').val() === auth.uid)",
          ".write": false
        },

        "checkins": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('sessions/' + $sid + '/meta/state').val() === 'CHECK_IN' && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)"
          }
        },

        "current_turn": {
          ".read": "auth != null && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)",
          "speaker_uid": {
            ".write": false
          },
          "listener_uid": {
            ".write": false
          },

          "translation": {
            "softened": {
              ".write": false
            },
            "changes_made": {
              ".write": false
            },
            "already_soft": {
              ".write": false
            },
            "cannot_soften": {
              ".write": false
            },
            "prompt_version": {
              ".write": false
            },
            "approved": {
              ".write": "auth != null && auth.uid === data.parent().parent().child('speaker_uid').val()"
            }
          },

          "delivered": {
            ".write": false
          },

          "mirror": {
            ".write": "auth != null && auth.uid === data.parent().child('listener_uid').val() && !data.exists() && root.child('sessions/' + $sid + '/meta/state').val() === 'IN_TURN'"
          },

          "speaker_confirmation": {
            ".write": "auth != null && auth.uid === data.parent().child('speaker_uid').val() && root.child('sessions/' + $sid + '/meta/state').val() === 'IN_TURN'"
          }
        },

        "speaker_draft": {
          ".read": "auth != null && auth.uid === root.child('sessions/' + $sid + '/current_turn/speaker_uid').val()",
          ".write": "auth != null && auth.uid === root.child('sessions/' + $sid + '/current_turn/speaker_uid').val() && root.child('sessions/' + $sid + '/meta/state').val() === 'IN_TURN'"
        },

        "listener_draft": {
          ".read": "auth != null && auth.uid === root.child('sessions/' + $sid + '/current_turn/listener_uid').val()",
          ".write": "auth != null && auth.uid === root.child('sessions/' + $sid + '/current_turn/listener_uid').val() && root.child('sessions/' + $sid + '/meta/state').val() === 'IN_TURN'"
        },

        "history": {
          ".read": "auth != null && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)",
          "$turnId": {
            ".write": false
          }
        },

        "flags": {
          ".read": "auth != null && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)",
          "$flagId": {
            ".write": false
          }
        },

        "presence": {
          ".read": "auth != null && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "summary": {
          ".read": "auth != null && (root.child('sessions/' + $sid + '/meta/partnerA').val() === auth.uid || root.child('sessions/' + $sid + '/meta/partnerB').val() === auth.uid)",
          "partner_a_summary": {
            ".write": false
          },
          "partner_b_summary": {
            ".write": false
          },
          "partner_a_confirmed": {
            ".write": "auth != null && auth.uid === root.child('sessions/' + $sid + '/meta/partnerA').val()"
          },
          "partner_b_confirmed": {
            ".write": "auth != null && auth.uid === root.child('sessions/' + $sid + '/meta/partnerB').val()"
          },
          "next_action": {
            ".write": "auth != null && (auth.uid === root.child('sessions/' + $sid + '/meta/partnerA').val() || auth.uid === root.child('sessions/' + $sid + '/meta/partnerB').val())"
          }
        }
      }
    },

    "pair_codes": {
      ".read": false,
      ".write": false
    },

    "meta": {
      ".read": false,
      ".write": false
    },

    "telemetry": {
      ".read": false,
      ".write": false
    },

    "appreciation_feed": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["created_at"],
        "$entryId": {
          ".write": "auth != null && !data.exists() && (auth.uid === $uid || auth.uid === newData.child('from_uid').val())",
          "reaction": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
