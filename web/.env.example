# Copy to .env.local and fill with real values before `npm run dev`.
# All VITE_* vars are inlined into the JS bundle at build time —
# never put server secrets here.

# Firebase Web SDK config (Firebase console → Project settings → General
# → Your apps → Web app → SDK setup → npm → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_AUTH_DOMAIN=

# Sentry DSN — leave empty in dev to disable crash reporting entirely.
# Sentry project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=

# Sentry environment tag: 'development' | 'pilot' | 'production'.
VITE_SENTRY_ENV=development
