# Copy to .env.local for local dev. Never commit .env.local.
# Cloud Functions runtime config (server-side only — never bundle into mobile)
ANTHROPIC_API_KEY=

# Firebase emulator hosts (used by tests + local dev)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Mobile dev config (public — safe to ship)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Optional: Sentry crash reporting for the mobile app.
# Leave blank to disable Sentry entirely (init becomes a no-op).
# Get a DSN from https://sentry.io → your project → Settings → Client Keys.
EXPO_PUBLIC_SENTRY_DSN=
