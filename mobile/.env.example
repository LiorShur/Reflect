# Copy to .env and fill with real values before running `expo start` or
# `eas build`. All EXPO_PUBLIC_* vars are inlined into the JS bundle at
# build time — never put server secrets here.

# Firebase Web SDK config (Project settings → General → Your apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Sentry DSN. Leave empty in dev to disable crash reporting entirely.
# Sentry project → Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Sentry environment tag. eas.json overrides this per build profile;
# only used when running `expo start` outside an EAS build.
EXPO_PUBLIC_SENTRY_ENV=development
