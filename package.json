{
  "name": "reflect",
  "version": "0.1.0",
  "private": true,
  "description": "Couples therapy app using Gottman speaker-listener technique with AI moderation",
  "workspaces": [
    "mobile",
    "functions",
    "eval"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "rules:test": "firebase emulators:exec --only database \"jest --config firebase/jest.config.js\"",
    "deploy:rules": "firebase deploy --only database",
    "deploy:functions": "firebase deploy --only functions",
    "eval": "ts-node eval/scripts/run-eval.ts",
    "eval-compare": "ts-node eval/scripts/compare-versions.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "firebase": "^10.14.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
